                        	     9: 
                        	    10: ; put the IRQ and MNI code in RAM so that it can be changed
                        	    11: 
                        	    12: IRQ_vec	= VEC_SV+2		; IRQ code vector
                        	    13: NMI_vec	= IRQ_vec+$0A	; NMI code vector
                        	    14: 
                        	    15: ; setup for the 6502 simulator environment
                        	    16: 
                        	    17: IO_AREA	= $F000		; set I/O area for this monitor
                        	    18: 
                        	    19: ACIAsimwr	= IO_AREA+$01	; simulated ACIA write port
                        	    20: ACIAsimrd	= IO_AREA+$04	; simulated ACIA read port
                        	    21: 
                        	    22: ; now the code. all this does is set up the vectors and interrupt code
                        	    23: ; and wait for the user to select [C]old or [W]arm start. nothing else
                        	    24: ; fits in less than 128 bytes
                        	    25: 
                        	    26: 	*=	$FF80			; pretend this is in a 1/8K ROM
                        	    27: 
                        	    28: ; reset vector points here
                        	    29: 
                        	    30: RES_vec
02:FF80 D8              	    31: 	CLD				; clear decimal mode
02:FF81 A2FF            	    32: 	LDX	#$FF			; empty stack
02:FF83 9A              	    33: 	TXS				; set the stack
                        	    34: 
                        	    35: ; set up vectors and interrupt code, copy them to page 2
                        	    36: 
02:FF84 A01C            	    37: 	LDY	#END_CODE-LAB_vec	; set index/count
                        	    38: LAB_stlp
02:FF86 B9BBFF          	    39: 	LDA	LAB_vec-1,Y		; get byte from interrupt code
02:FF89 990402          	    40: 	STA	VEC_IN-1,Y		; save to RAM
02:FF8C 88              	    41: 	DEY				; decrement index/count
02:FF8D D0F7            	    42: 	BNE	LAB_stlp		; loop if more to do
                        	    43: 
                        	    44: ; now do the signon message, Y = $00 here
                        	    45: 
                        	    46: LAB_signon
02:FF8F B9D8FF          	    47: 	LDA	LAB_mess,Y		; get byte from sign on message
02:FF92 F006            	    48: 	BEQ	LAB_nokey		; exit loop if done
                        	    49: 
02:FF94 20EDE0          	    50: 	JSR	V_OUTP		; output character
02:FF97 C8              	    51: 	INY				; increment index
02:FF98 D0F5            	    52: 	BNE	LAB_signon		; loop, branch always
                        	    53: 
                        	    54: LAB_nokey
02:FF9A 20EAE0          	    55: 	JSR	V_INPT		; call scan input device
02:FF9D 90FB            	    56: 	BCC	LAB_nokey		; loop if no key
                        	    57: 
02:FF9F 29DF            	    58: 	AND	#$DF			; mask xx0x xxxx, ensure upper case
02:FFA1 C957            	    59: 	CMP	#'W'			; compare with [W]arm start
02:FFA3 F007            	    60: 	BEQ	LAB_dowarm		; branch if [W]arm start
                        	    61: 
02:FFA5 C943            	    62: 	CMP	#'C'			; compare with [C]old start
02:FFA7 D0D7            	    63: 	BNE	RES_vec		; loop if not [C]old start
                        	    64: 
02:FFA9 4C00C0          	    65: 	JMP	LAB_COLD		; do EhBASIC cold start
                        	    66: 
                        	    67: LAB_dowarm
02:FFAC 4C0000          	    68: 	JMP	LAB_WARM		; do EhBASIC warm start
                        	    69: 
                        	    70: ; byte out to simulated ACIA
                        	    71: 
                        	    72: ACIAout
02:FFAF 8D01F0          	    73: 	STA	ACIAsimwr		; save byte to simulated ACIA
02:FFB2 60              	    74: 	RTS
                        	    75: 
                        	    76: ; byte in from simulated ACIA
                        	    77: 
                        	    78: ACIAin
02:FFB3 AD04F0          	    79: 	LDA	ACIAsimrd		; get byte from simulated ACIA
02:FFB6 F002            	    80: 	BEQ	LAB_nobyw		; branch if no byte waiting
                        	    81: 
02:FFB8 38              	    82: 	SEC				; flag byte received
02:FFB9 60              	    83: 	RTS
                        	    84: 
                        	    85: LAB_nobyw
02:FFBA 18              	    86: 	CLC				; flag no byte received
                        	    87: no_load				; empty load vector for EhBASIC
                        	    88: no_save				; empty save vector for EhBASIC
02:FFBB 60              	    89: 	RTS
                        	    90: 
                        	    91: ; vector tables
                        	    92: 
                        	    93: LAB_vec
02:FFBC B3FF            	    94: 	.word	ACIAin		; byte in from simulated ACIA
02:FFBE AFFF            	    95: 	.word	ACIAout		; byte out to simulated ACIA
02:FFC0 BBFF            	    96: 	.word	no_load		; null load vector for EhBASIC
02:FFC2 BBFF            	    97: 	.word	no_save		; null save vector for EhBASIC
                        	    98: 
                        	    99: ; EhBASIC IRQ support
                        	   100: 
                        	   101: IRQ_CODE
02:FFC4 48              	   102: 	PHA				; save A
02:FFC5 A5DF            	   103: 	LDA	IrqBase		; get the IRQ flag byte
02:FFC7 4A              	   104: 	LSR				; shift the set b7 to b6, and on down ...
02:FFC8 05DF            	   105: 	ORA	IrqBase		; OR the original back in
02:FFCA 85DF            	   106: 	STA	IrqBase		; save the new IRQ flag byte
02:FFCC 68              	   107: 	PLA				; restore A
02:FFCD 40              	   108: 	RTI
                        	   109: 
                        	   110: ; EhBASIC NMI support
                        	   111: 
                        	   112: NMI_CODE
02:FFCE 48              	   113: 	PHA				; save A
02:FFCF A5DC            	   114: 	LDA	NmiBase		; get the NMI flag byte
02:FFD1 4A              	   115: 	LSR				; shift the set b7 to b6, and on down ...
02:FFD2 05DC            	   116: 	ORA	NmiBase		; OR the original back in
02:FFD4 85DC            	   117: 	STA	NmiBase		; save the new NMI flag byte
02:FFD6 68              	   118: 	PLA				; restore A
02:FFD7 40              	   119: 	RTI
                        	   120: 
                        	   121: END_CODE
