01:E047 A900            	  7591: 	LDA	#$00			; clear A
                        	  7592: 
01:E049 8577            	  7593: 	STA	FACt_3		; clear remainder
01:E04B 8576            	  7594: 	STA	FACt_2		; ..
01:E04D 8575            	  7595: 	STA	FACt_1		; ..
01:E04F 8578            	  7596: 	STA	TempB			; ..
                        	  7597: 
01:E051 85AF            	  7598: 	STA	FAC1_3		; clear root
01:E053 85AE            	  7599: 	STA	FAC1_2		; ..
01:E055 85AD            	  7600: 	STA	FAC1_1		; ..
                        	  7601: 
01:E057 A218            	  7602: 	LDX	#$18			; 24 pairs of bits to do
01:E059 A5B3            	  7603: 	LDA	FAC2_e		; get exponent
01:E05B 4A              	  7604: 	LSR				; check odd/even
01:E05C B00E            	  7605: 	BCS	LAB_SQE2		; if odd only 1 shift first time
                        	  7606: 
                        	  7607: LAB_SQE1
01:E05E 06B6            	  7608: 	ASL	FAC2_3		; shift highest bit of number ..
01:E060 26B5            	  7609: 	ROL	FAC2_2		; ..
01:E062 26B4            	  7610: 	ROL	FAC2_1		; ..
01:E064 2677            	  7611: 	ROL	FACt_3		; .. into remainder
01:E066 2676            	  7612: 	ROL	FACt_2		; ..
01:E068 2675            	  7613: 	ROL	FACt_1		; ..
01:E06A 2678            	  7614: 	ROL	TempB			; .. never overflows
                        	  7615: LAB_SQE2
01:E06C 06B6            	  7616: 	ASL	FAC2_3		; shift highest bit of number ..
01:E06E 26B5            	  7617: 	ROL	FAC2_2		; ..
01:E070 26B4            	  7618: 	ROL	FAC2_1		; ..
01:E072 2677            	  7619: 	ROL	FACt_3		; .. into remainder
01:E074 2676            	  7620: 	ROL	FACt_2		; ..
01:E076 2675            	  7621: 	ROL	FACt_1		; ..
01:E078 2678            	  7622: 	ROL	TempB			; .. never overflows
                        	  7623: 
01:E07A 06AF            	  7624: 	ASL	FAC1_3		; root = root * 2
01:E07C 26AE            	  7625: 	ROL	FAC1_2		; ..
01:E07E 26AD            	  7626: 	ROL	FAC1_1		; .. never overflows
                        	  7627: 
01:E080 A5AF            	  7628: 	LDA	FAC1_3		; get root low byte
01:E082 2A              	  7629: 	ROL				; *2
01:E083 855B            	  7630: 	STA	Temp3			; save partial low byte
01:E085 A5AE            	  7631: 	LDA	FAC1_2		; get root low mid byte
01:E087 2A              	  7632: 	ROL				; *2
01:E088 855C            	  7633: 	STA	Temp3+1		; save partial low mid byte
01:E08A A5AD            	  7634: 	LDA	FAC1_1		; get root high mid byte
01:E08C 2A              	  7635: 	ROL				; *2
01:E08D 855D            	  7636: 	STA	Temp3+2		; save partial high mid byte
01:E08F A900            	  7637: 	LDA	#$00			; get root high byte (always $00)
01:E091 2A              	  7638: 	ROL				; *2
01:E092 855E            	  7639: 	STA	Temp3+3		; save partial high byte
                        	  7640: 
                        	  7641: 					; carry clear for subtract +1
01:E094 A577            	  7642: 	LDA	FACt_3		; get remainder low byte
01:E096 E55B            	  7643: 	SBC	Temp3			; subtract partial low byte
01:E098 855B            	  7644: 	STA	Temp3			; save partial low byte
                        	  7645: 
01:E09A A576            	  7646: 	LDA	FACt_2		; get remainder low mid byte
01:E09C E55C            	  7647: 	SBC	Temp3+1		; subtract partial low mid byte
01:E09E 855C            	  7648: 	STA	Temp3+1		; save partial low mid byte
                        	  7649: 
01:E0A0 A575            	  7650: 	LDA	FACt_1		; get remainder high mid byte
01:E0A2 E55D            	  7651: 	SBC	Temp3+2		; subtract partial high mid byte
01:E0A4 A8              	  7652: 	TAY				; copy partial high mid byte
                        	  7653: 
01:E0A5 A578            	  7654: 	LDA	TempB			; get remainder high byte
01:E0A7 E55E            	  7655: 	SBC	Temp3+3		; subtract partial high byte
01:E0A9 900E            	  7656: 	BCC	LAB_SQNS		; skip sub if remainder smaller
                        	  7657: 
01:E0AB 8578            	  7658: 	STA	TempB			; save remainder high byte
                        	  7659: 
01:E0AD 8475            	  7660: 	STY	FACt_1		; save remainder high mid byte
                        	  7661: 
01:E0AF A55C            	  7662: 	LDA	Temp3+1		; get remainder low mid byte
01:E0B1 8576            	  7663: 	STA	FACt_2		; save remainder low mid byte
                        	  7664: 
01:E0B3 A55B            	  7665: 	LDA	Temp3			; get partial low byte
01:E0B5 8577            	  7666: 	STA	FACt_3		; save remainder low byte
                        	  7667: 
01:E0B7 E6AF            	  7668: 	INC	FAC1_3		; increment root low byte (never any rollover)
                        	  7669: LAB_SQNS
01:E0B9 CA              	  7670: 	DEX				; decrement bit pair count
01:E0BA D0A2            	  7671: 	BNE	LAB_SQE1		; loop if not all done
                        	  7672: 
01:E0BC 38              	  7673: 	SEC				; set carry for subtract
01:E0BD A5B3            	  7674: 	LDA	FAC2_e		; get exponent
01:E0BF E980            	  7675: 	SBC	#$80			; normalise
01:E0C1 6A              	  7676: 	ROR				; /2 and re-bias to $80
01:E0C2 6900            	  7677: 	ADC	#$00			; add bit zero back in (allow for half shift)
01:E0C4 85AC            	  7678: 	STA	FAC1_e		; save it
01:E0C6 4C34D6          	  7679: 	JMP	LAB_24D5		; normalise FAC1 and return
                        	  7680: 
                        	  7681: ; perform VARPTR()
