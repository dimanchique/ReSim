                        	  7733: 
                        	  7734: ; character get subroutine for zero page
                        	  7735: 
                        	  7736: ; For a 1.8432MHz 6502 including the JSR and RTS
                        	  7737: ; fastest (>=":")	=  29 cycles =  15.7uS
                        	  7738: ; slowest (<":")	=  40 cycles =  21.7uS
                        	  7739: ; space skip	= +21 cycles = +11.4uS
                        	  7740: ; inc across page	=  +4 cycles =  +2.2uS
                        	  7741: 
                        	  7742: ; the target address for the LDA at LAB_2CF4 becomes the BASIC execute pointer once the
                        	  7743: ; block is copied to it's destination, any non zero page address will do at assembly
                        	  7744: ; time, to assemble a three byte instruction.
                        	  7745: 
                        	  7746: ; page 0 initialisation table from $BC
                        	  7747: ; increment and scan memory
                        	  7748: 
                        	  7749: LAB_2CEE
01:E0FB E6C3            	  7750: 	INC	Bpntrl		; increment BASIC execute pointer low byte
01:E0FD D002            	  7751: 	BNE	LAB_2CF4		; branch if no carry
                        	  7752: 					; else
01:E0FF E6C4            	  7753: 	INC	Bpntrh		; increment BASIC execute pointer high byte
                        	  7754: 
