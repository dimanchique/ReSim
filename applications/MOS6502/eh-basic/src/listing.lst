01:E0D9 A9BB            	  7694: 	LDA	#<LAB_2C7C		; set (2*pi) pointer low byte
01:E0DB A0E1            	  7695: 	LDY	#>LAB_2C7C		; set (2*pi) pointer high byte
01:E0DD 207DD8          	  7696: 	JSR	LAB_UFAC		; unpack memory (AY) into FAC1
01:E0E0 C6AC            	  7697: 	DEC	FAC1_e		; make result = PI
01:E0E2 60              	  7698: 	RTS
