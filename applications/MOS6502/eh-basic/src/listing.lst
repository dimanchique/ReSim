                        	  7683: LAB_VARPTR
01:E0C9 20BC00          	  7684: 	JSR	LAB_IGBY		; increment and scan memory
01:E0CC 20AACD          	  7685: 	JSR	LAB_GVAR		; get var address
01:E0CF 20EFCB          	  7686: 	JSR	LAB_1BFB		; scan for ")" , else do syntax error then warm start
01:E0D2 A495            	  7687: 	LDY	Cvaral		; get var address low byte
01:E0D4 A596            	  7688: 	LDA	Cvarah		; get var address high byte
01:E0D6 4C59D0          	  7689: 	JMP	LAB_AYFC		; save and convert integer AY to FAC1 and return
