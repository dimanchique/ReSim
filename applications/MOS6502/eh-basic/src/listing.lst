                        	  7756: ; scan memory
                        	  7757: 
                        	  7758: LAB_2CF4
01:E101 ADFFFF          	  7759: 	LDA	$FFFF			; get byte to scan (addr set by call routine)
01:E104 C9AC            	  7760: 	CMP	#TK_ELSE		; compare with the token for ELSE
01:E106 F00E            	  7761: 	BEQ	LAB_2D05		; exit if ELSE, not numeric, carry set
                        	  7762: 
01:E108 C93A            	  7763: 	CMP	#':'			; compare with ":"
01:E10A B00A            	  7764: 	BCS	LAB_2D05		; exit if >= ":", not numeric, carry set
                        	  7765: 
01:E10C C920            	  7766: 	CMP	#' '			; compare with " "
01:E10E F0EB            	  7767: 	BEQ	LAB_2CEE		; if " " go do next
                        	  7768: 
01:E110 38              	  7769: 	SEC				; set carry for SBC
01:E111 E930            	  7770: 	SBC	#'0'			; subtract "0"
01:E113 38              	  7771: 	SEC				; set carry for SBC
01:E114 E9D0            	  7772: 	SBC	#$D0			; subtract -"0"
