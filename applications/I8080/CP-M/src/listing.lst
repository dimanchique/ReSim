                        	  1236: ;
                        	  1237: ;   Note that the following six bytes must match those at
                        	  1238: ; (PATTRN1) or cp/m will HALT. Why?
                        	  1239: ;
01:E400 00              	  1240: PATTRN2	DB	0,22,0,0,0,0;(* serial number bytes *).
01:E401 16
01:E402 00
01:E403 00
01:E404 00
01:E405 00
                        	  1241: ;
                        	  1242: ;**************************************************************
                        	  1243: ;*
                        	  1244: ;*                    B D O S   E N T R Y
                        	  1245: ;*
                        	  1246: ;**************************************************************
                        	  1247: ;
01:E406 C311E4          	  1248: FBASE	JMP	FBASE1
                        	  1249: ;
                        	  1250: ;   Bdos error table.
                        	  1251: ;
01:E409 99E4            	  1252: BADSCTR	DW	ERROR1	;bad sector on read or write.
01:E40B A5E4            	  1253: BADSLCT	DW	ERROR2	;bad disk select.
01:E40D ABE4            	  1254: RODISK	DW	ERROR3	;disk is read only.
01:E40F B1E4            	  1255: ROFILE	DW	ERROR4	;file is read only.
                        	  1256: ;
                        	  1257: ;   Entry into bdos. (DE) or (E) are the parameters passed. The
                        	  1258: ; function number desired is in register (C).
                        	  1259: ;
01:E411 EB              	  1260: FBASE1	XCHG		;save the (DE) parameters.
01:E412 2247E7          	  1261: 	SHLD	PARAMS
01:E415 EB              	  1262: 	XCHG
01:E416 7B              	  1263: 	MOV	A,E	;and save register (E) in particular.
01:E417 32DAF1          	  1264: 	STA	EPARAM
01:E41A 210000          	  1265: 	LXI	H,0
01:E41D 2249E7          	  1266: 	SHLD	STATUS	;clear return status.
01:E420 39              	  1267: 	DAD	SP
01:E421 2213E7          	  1268: 	SHLD	USRSTACK;save users stack pointer.
01:E424 3145E7          	  1269: 	LXI	SP,STKAREA;and set our own.
01:E427 AF              	  1270: 	XRA	A	;clear auto select storage space.
01:E428 32E4F1          	  1271: 	STA	AUTOFLAG
01:E42B 32E2F1          	  1272: 	STA	AUTO
01:E42E 2178F1          	  1273: 	LXI	H,GOBACK;set return address.
01:E431 E5              	  1274: 	PUSH	H
01:E432 79              	  1275: 	MOV	A,C	;get function number.
01:E433 FE29            	  1276: 	CPI	NFUNCTS	;valid function number?
01:E435 D0              	  1277: 	RNC
01:E436 4B              	  1278: 	MOV	C,E	;keep single register function here.
01:E437 2147E4          	  1279: 	LXI	H,FUNCTNS;now look thru the function table.
01:E43A 5F              	  1280: 	MOV	E,A
01:E43B 1600            	  1281: 	MVI	D,0	;(DE)=function number.
01:E43D 19              	  1282: 	DAD	D
01:E43E 19              	  1283: 	DAD	D	;(HL)=(start of table)+2*(function number).
01:E43F 5E              	  1284: 	MOV	E,M
01:E440 23              	  1285: 	INX	H
01:E441 56              	  1286: 	MOV	D,M	;now (DE)=address for this function.
01:E442 2A47E7          	  1287: 	LHLD	PARAMS	;retrieve parameters.
01:E445 EB              	  1288: 	XCHG		;now (DE) has the original parameters.
01:E446 E9              	  1289: 	PCHL		;execute desired function.
                        	  1290: ;
                        	  1291: ;   BDOS function jump table.
                        	  1292: ;
                        	  1293: NFUNCTS	EQU	41	;number of functions in followin table.
                        	  1294: ;
01:E447 AAF2            	  1295: FUNCTNS	DW	WBOOT,GETCON,OUTCON,GETRDR,PUNCH,LIST,DIRCIO,GETIOB
01:E449 CCE6
01:E44B 94E5
01:E44D D2E6
01:E44F 49F3
01:E451 45F3
01:E453 D8E6
01:E455 F1E6
01:E457 F7E6            	  1296: 	DW	SETIOB,PRTSTR,RDBUFF,GETCSTS,GETVER,RSTDSK,SETDSK,OPENFIL
01:E459 FCE6
01:E45B E5E5
01:E45D 02E7
01:E45F 82F0
01:E461 87F0
01:E463 49F0
01:E465 A0F0
01:E467 A9F0            	  1297: 	DW	CLOSEFIL,GETFST,GETNXT,DELFILE,READSEQ,WRTSEQ,FCREATE
01:E469 AFF0
01:E46B CCF0
01:E46D DBF0
01:E46F E4F0
01:E471 EAF0
01:E473 F0F0
01:E475 F9F0            	  1298: 	DW	RENFILE,GETLOG,GETCRNT,PUTDMA,GETALOC,WRTPRTD,GETROV,SETATTR
01:E477 02F1
01:E479 08F1
01:E47B 0EF1
01:E47D 15F1
01:E47F 30E9
01:E481 1BF1
01:E483 21F1
01:E485 2AF1            	  1299: 	DW	GETPARM,GETUSER,RDRANDOM,WTRANDOM,FILESIZE,SETRAN,LOGOFF,RTN
01:E487 31F1
