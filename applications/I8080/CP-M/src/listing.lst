01:E5DD 4F              	  1504: 	MOV	C,A
01:E5DE CD94E5          	  1505: 	CALL	OUTCON
01:E5E1 C1              	  1506: 	POP	B
01:E5E2 C3D7E5          	  1507: 	JMP	PRTMESG
                        	  1508: ;
                        	  1509: ;   Function to execute a buffered read.
                        	  1510: ;
01:E5E5 3A10E7          	  1511: RDBUFF	LDA	CURPOS	;use present location as starting one.
01:E5E8 320FE7          	  1512: 	STA	STARTING
01:E5EB 2A47E7          	  1513: 	LHLD	PARAMS	;get the maximum buffer space.
01:E5EE 4E              	  1514: 	MOV	C,M
