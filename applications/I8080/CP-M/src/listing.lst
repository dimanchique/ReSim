01:EA22 0605            	  2307: 	MVI	B,5	;convert to relative position (32 bytes each).
01:EA24 87              	  2308: NXENT2	ADD	A	;note that this is not efficient code.
01:EA25 05              	  2309: 	DCR	B	;5 'ADD A's would be better.
01:EA26 C224EA          	  2310: 	JNZ	NXENT2
