01:E5D2 0E0A            	  1494: 	MVI	C,LF
01:E5D4 C34CE5          	  1495: 	JMP	OUTCHAR
                        	  1496: ;
                        	  1497: ;   Print message pointed to by (BC). It will end with a '$'.
                        	  1498: ;
01:E5D7 0A              	  1499: PRTMESG	LDAX	B	;check for terminating character.
01:E5D8 FE24            	  1500: 	CPI	'$'
01:E5DA C8              	  1501: 	RZ
01:E5DB 03              	  1502: 	INX	B
