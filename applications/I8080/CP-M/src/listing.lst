                        	    10: ;**************************************************************
                        	    11: ;
                        	    12: ;   Set memory limit here. This is the amount of contigeous
                        	    13: ; ram starting from 0000. CP/M will reside at the end of this space.
                        	    14: ;
                        	    15: MEM	EQU	62	;for a 62k system (TS802 TEST - WORKS OK).
                        	    16: ;
                        	    17: IOBYTE	EQU	3	;i/o definition byte.
                        	    18: TDRIVE	EQU	4	;current drive name and user number.
                        	    19: ENTRY	EQU	5	;entry point for the cp/m bdos.
                        	    20: TFCB	EQU	5CH	;default file control block.
                        	    21: TBUFF	EQU	80H	;i/o buffer and command line storage.
                        	    22: TBASE	EQU	100H	;transiant program storage area.
                        	    23: ;
                        	    24: ;   Set control character equates.
                        	    25: ;
                        	    26: CNTRLC	EQU	3	;control-c
                        	    27: CNTRLE	EQU	05H	;control-e
                        	    28: BS	EQU	08H	;backspace
                        	    29: TAB	EQU	09H	;tab
                        	    30: LF	EQU	0AH	;line feed
                        	    31: FF	EQU	0CH	;form feed
                        	    32: CR	EQU	0DH	;carriage return
                        	    33: CNTRLP	EQU	10H	;control-p
                        	    34: CNTRLR	EQU	12H	;control-r
                        	    35: CNTRLS	EQU	13H	;control-s
                        	    36: CNTRLU	EQU	15H	;control-u
                        	    37: CNTRLX	EQU	18H	;control-x
                        	    38: CNTRLZ	EQU	1AH	;control-z (end-of-file mark)
                        	    39: DEL	EQU	7FH	;rubout
                        	    40: ;
                        	    41: ;   Set origin for CP/M
                        	    42: ;
                        	    43: ; Boot vector at address 0 - jump to BIOS cold boot
                        	    44: 	ORG	0
00:0000 C300F2          	    45: 	JMP	((MEM-7)*1024) + 1600h	;jump to BIOS entry 0 (BOOT)
00:0003 00              	    46: 	DB	0			;IOBYTE at address 3
00:0004 00              	    47: 	DB	0			;CDISK at address 4
                        	    48: ;	Address 5-7 reserved for JMP BDOS (set by GOCPM at runtime)
                        	    49: ;
                        	    50: ; System code starts at CBASE
                        	    51: 	ORG	(MEM-7)*1024
                        	    52: ;
01:DC00 C35CDF          	    53: CBASE	JMP	COMMAND	;execute command processor (ccp).
01:DC03 C358DF          	    54: 	JMP	CLEARBUF	;entry to empty input buffer before starting ccp.
                        	    55: 
                        	    56: ;
                        	    57: ;   Standard cp/m ccp input buffer. Format is (max length),
                        	    58: ; (actual length), (char #1), (char #2), (char #3), etc.
                        	    59: ;
01:DC06 7F              	    60: INBUFF	DB	127	;length of input buffer.
01:DC07 00              	    61: 	DB	0	;current length of contents.
