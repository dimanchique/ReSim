01:E593 4F              	  1451: 	MOV	C,A
                        	  1452: ;
                        	  1453: ;   Function to output (C) to the console device and expand tabs
                        	  1454: ; if necessary.
                        	  1455: ;
01:E594 79              	  1456: OUTCON	MOV	A,C
01:E595 FE09            	  1457: 	CPI	TAB	;is it a tab?
01:E597 C24CE5          	  1458: 	JNZ	OUTCHAR	;use regular output.
01:E59A 0E20            	  1459: OUTCON1	MVI	C,' '	;yes it is, use spaces instead.
01:E59C CD4CE5          	  1460: 	CALL	OUTCHAR
01:E59F 3A10E7          	  1461: 	LDA	CURPOS	;go until the cursor is at a multiple of 8
                        	  1462: 
01:E5A2 E607            	  1463: 	ANI	07H	;position.
01:E5A4 C29AE5          	  1464: 	JNZ	OUTCON1
01:E5A7 C9              	  1465: 	RET
                        	  1466: ;
                        	  1467: ;   Echo a backspace character. Erase the prevoius character
                        	  1468: ; on the screen.
                        	  1469: ;
01:E5A8 CDB0E5          	  1470: BACKUP	CALL	BACKUP1	;backup the screen 1 place.
01:E5AB 0E20            	  1471: 	MVI	C,' '	;then blank that character.
01:E5AD CD35F3          	  1472: 	CALL	CONOUT
