01:EA8D C5              	  2408: 	PUSH	B
01:EA8E 4E              	  2409: 	MOV	C,M	;now get both the low and high bytes.
01:EA8F 23              	  2410: 	INX	H
01:EA90 46              	  2411: 	MOV	B,M
01:EA91 E5              	  2412: 	PUSH	H
01:EA92 79              	  2413: SETFL3	MOV	A,C	;block used?
