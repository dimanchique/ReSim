01:E48B 4BF1
01:E48D 51F1
01:E48F 12F0
01:E491 57F1
01:E493 08E7
01:E495 08E7            	  1300: 	DW	RTN,WTSPECL
01:E497 9FF1
                        	  1301: ;
                        	  1302: ;   Bdos error message section.
                        	  1303: ;
01:E499 21CEE4          	  1304: ERROR1	LXI	H,BADSEC	;bad sector message.
01:E49C CDE9E4          	  1305: 	CALL	PRTERR	;print it and get a 1 char responce.
01:E49F FE03            	  1306: 	CPI	CNTRLC	;re-boot request (control-c)?
01:E4A1 CA0000          	  1307: 	JZ	0	;yes.
01:E4A4 C9              	  1308: 	RET		;no, return to retry i/o function.
                        	  1309: ;
01:E4A5 21D9E4          	  1310: ERROR2	LXI	H,BADSEL	;bad drive selected.
01:E4A8 C3B4E4          	  1311: 	JMP	ERROR5
                        	  1312: ;
01:E4AB 21E5E4          	  1313: ERROR3	LXI	H,DISKRO	;disk is read only.
01:E4AE C3B4E4          	  1314: 	JMP	ERROR5
                        	  1315: ;
01:E4B1 21E0E4          	  1316: ERROR4	LXI	H,FILERO	;file is read only.
                        	  1317: ;
01:E4B4 CDE9E4          	  1318: ERROR5	CALL	PRTERR
01:E4B7 AF              	  1319: 	XRA	A
01:E4B8 320400          	  1320: 	STA	CDISK	;reset current disk to A: on error reboot
01:E4BB C30000          	  1321: 	JMP	0	;always reboot on these errors.
                        	  1322: ;
01:E4BE 42646F7320457272	  1323: BDOSERR	DB	'Bdos Err On '
01:E4C6 204F6E20
01:E4CA 203A2024        	  1324: BDOSDRV	DB	' : $'
01:E4CE 4261642053656374	  1325: BADSEC	DB	'Bad Sector$'
01:E4D6 6F7224
01:E4D9 53656C65637424  	  1326: BADSEL	DB	'Select$'
01:E4E0 46696C6520      	  1327: FILERO	DB	'File '
01:E4E5 522F4F24        	  1328: DISKRO	DB	'R/O$'
                        	  1329: ;
                        	  1330: ;   Print bdos error message.
                        	  1331: ;
01:E4E9 E5              	  1332: PRTERR	PUSH	H	;save second message pointer.
01:E4EA CDCDE5          	  1333: 	CALL	OUTCRLF	;send (cr)(lf).
01:E4ED 3A46E7          	  1334: 	LDA	ACTIVE	;get active drive.
01:E4F0 C641            	  1335: 	ADI	'A'	;make ascii.
01:E4F2 32CAE4          	  1336: 	STA	BDOSDRV	;and put in message.
01:E4F5 01BEE4          	  1337: 	LXI	B,BDOSERR;and print it.
01:E4F8 CDD7E5          	  1338: 	CALL	PRTMESG
01:E4FB C1              	  1339: 	POP	B	;print second message line now.
01:E4FC CDD7E5          	  1340: 	CALL	PRTMESG
                        	  1341: ;
                        	  1342: ;   Get an input character. We will check our 1 character
                        	  1343: ; buffer first. This may be set by the console status routine.
                        	  1344: ;
01:E4FF 2112E7          	  1345: GETCHAR	LXI	H,CHARBUF;check character buffer.
01:E502 7E              	  1346: 	MOV	A,M	;anything present already?
01:E503 3600            	  1347: 	MVI	M,0	;...either case clear it.
01:E505 B7              	  1348: 	ORA	A
01:E506 C0              	  1349: 	RNZ		;yes, use it.
01:E507 C323F3          	  1350: 	JMP	CONIN	;nope, go get a character responce.
                        	  1351: ;
                        	  1352: ;   Input and echo a character.
                        	  1353: ;
01:E50A CDFFE4          	  1354: GETECHO	CALL	GETCHAR	;input a character.
01:E50D CD18E5          	  1355: 	CALL	CHKCHAR	;carriage control?
01:E510 D8              	  1356: 	RC		;no, a regular control char so don't echo.
01:E511 F5              	  1357: 	PUSH	PSW	;ok, save character now.
01:E512 4F              	  1358: 	MOV	C,A
01:E513 CD94E5          	  1359: 	CALL	OUTCON	;and echo it.
01:E516 F1              	  1360: 	POP	PSW	;get character and return.
01:E517 C9              	  1361: 	RET
                        	  1362: ;
                        	  1363: ;   Check character in (A). Set the zero flag on a carriage
                        	  1364: ; control character and the carry flag on any other control
                        	  1365: ; character.
                        	  1366: ;
01:E518 FE0D            	  1367: CHKCHAR	CPI	CR	;check for carriage return, line feed, backspace,
01:E51A C8              	  1368: 	RZ		;or a tab.
01:E51B FE0A            	  1369: 	CPI	LF
01:E51D C8              	  1370: 	RZ
01:E51E FE09            	  1371: 	CPI	TAB
01:E520 C8              	  1372: 	RZ
01:E521 FE08            	  1373: 	CPI	BS
01:E523 C8              	  1374: 	RZ
01:E524 FE20            	  1375: 	CPI	' '	;other control char? Set carry flag.
01:E526 C9              	  1376: 	RET
                        	  1377: ;
                        	  1378: ;   Check the console during output. Halt on a control-s, then
                        	  1379: ; reboot on a control-c. If anything else is ready, clear the
                        	  1380: ; zero flag and return (the calling routine may want to do
                        	  1381: ; something).
                        	  1382: ;
01:E527 3A12E7          	  1383: CKCONSOL:LDA	CHARBUF	;check buffer.
01:E52A B7              	  1384: 	ORA	A	;if anything, just return without checking.
01:E52B C249E5          	  1385: 	JNZ	CKCON2
01:E52E CD13F3          	  1386: 	CALL	CONST	;nothing in buffer. Check console.
01:E531 E601            	  1387: 	ANI	01H	;look at bit 0.
01:E533 C8              	  1388: 	RZ		;return if nothing.
01:E534 CD23F3          	  1389: 	CALL	CONIN	;ok, get it.
01:E537 FE13            	  1390: 	CPI	CNTRLS	;if not control-s, return with zero cleared.
01:E539 C246E5          	  1391: 	JNZ	CKCON1
01:E53C CD23F3          	  1392: 	CALL	CONIN	;halt processing until another char
01:E53F FE03            	  1393: 	CPI	CNTRLC	;is typed. Control-c?
01:E541 CA0000          	  1394: 	JZ	0	;yes, reboot now.
01:E544 AF              	  1395: 	XRA	A	;no, just pretend nothing was ever ready.
01:E545 C9              	  1396: 	RET
01:E546 3212E7          	  1397: CKCON1	STA	CHARBUF	;save character in buffer for later processing.
01:E549 3E01            	  1398: CKCON2	MVI	A,1	;set (A) to non zero to mean something is ready.
01:E54B C9              	  1399: 	RET
                        	  1400: ;
                        	  1401: ;   Output (C) to the screen. If the printer flip-flop flag
                        	  1402: ; is set, we will send character to printer also. The console
                        	  1403: ; will be checked in the process.
                        	  1404: ;
01:E54C 3A0EE7          	  1405: OUTCHAR	LDA	OUTFLAG	;check output flag.
01:E54F B7              	  1406: 	ORA	A	;anything and we won't generate output.
01:E550 C266E5          	  1407: 	JNZ	OUTCHR1
01:E553 C5              	  1408: 	PUSH	B
01:E554 CD27E5          	  1409: 	CALL	CKCONSOL;check console (we don't care whats there).
01:E557 C1              	  1410: 	POP	B
01:E558 C5              	  1411: 	PUSH	B
01:E559 CD35F3          	  1412: 	CALL	CONOUT	;output (C) to the screen.
01:E55C C1              	  1413: 	POP	B
01:E55D C5              	  1414: 	PUSH	B
01:E55E 3A11E7          	  1415: 	LDA	PRTFLAG	;check printer flip-flop flag.
01:E561 B7              	  1416: 	ORA	A
01:E562 C445F3          	  1417: 	CNZ	LIST	;print it also if non-zero.
01:E565 C1              	  1418: 	POP	B
01:E566 79              	  1419: OUTCHR1	MOV	A,C	;update cursors position.
01:E567 2110E7          	  1420: 	LXI	H,CURPOS
01:E56A FE7F            	  1421: 	CPI	DEL	;rubouts don't do anything here.
01:E56C C8              	  1422: 	RZ
01:E56D 34              	  1423: 	INR	M	;bump line pointer.
01:E56E FE20            	  1424: 	CPI	' '	;and return if a normal character.
01:E570 D0              	  1425: 	RNC
01:E571 35              	  1426: 	DCR	M	;restore and check for the start of the line.
01:E572 7E              	  1427: 	MOV	A,M
01:E573 B7              	  1428: 	ORA	A
01:E574 C8              	  1429: 	RZ		;ingnore control characters at the start of the line.
01:E575 79              	  1430: 	MOV	A,C
01:E576 FE08            	  1431: 	CPI	BS	;is it a backspace?
01:E578 C27DE5          	  1432: 	JNZ	OUTCHR2
01:E57B 35              	  1433: 	DCR	M	;yes, backup pointer.
01:E57C C9              	  1434: 	RET
01:E57D FE0A            	  1435: OUTCHR2	CPI	LF	;is it a line feed?
01:E57F C0              	  1436: 	RNZ		;ignore anything else.
01:E580 3600            	  1437: 	MVI	M,0	;reset pointer to start of line.
01:E582 C9              	  1438: 	RET
                        	  1439: ;
                        	  1440: ;   Output (A) to the screen. If it is a control character
                        	  1441: ; (other than carriage control), use ^x format.
                        	  1442: ;
01:E583 79              	  1443: SHOWIT	MOV	A,C
01:E584 CD18E5          	  1444: 	CALL	CHKCHAR	;check character.
01:E587 D294E5          	  1445: 	JNC	OUTCON	;not a control, use normal output.
01:E58A F5              	  1446: 	PUSH	PSW
01:E58B 0E5E            	  1447: 	MVI	C,'^'	;for a control character, preceed it with '^'.
01:E58D CD4CE5          	  1448: 	CALL	OUTCHAR
01:E590 F1              	  1449: 	POP	PSW
