                        	  1717: ;
                        	  1718: ;   Jump to (HL) indirectly.
                        	  1719: ;
01:E74E 5E              	  1720: JUMPHL	MOV	E,M
01:E74F 23              	  1721: 	INX	H
01:E750 56              	  1722: 	MOV	D,M	;now (DE) contain the desired address.
01:E751 EB              	  1723: 	XCHG
01:E752 E9              	  1724: 	PCHL
                        	  1725: ;
                        	  1726: ;   Block move. (DE) to (HL), (C) bytes total.
                        	  1727: ;
01:E753 0C              	  1728: DE2HL	INR	C	;is count down to zero?
01:E754 0D              	  1729: DE2HL1	DCR	C
01:E755 C8              	  1730: 	RZ		;yes, we are done.
01:E756 1A              	  1731: 	LDAX	D	;no, move one more byte.
01:E757 77              	  1732: 	MOV	M,A
01:E758 13              	  1733: 	INX	D
01:E759 23              	  1734: 	INX	H
01:E75A C354E7          	  1735: 	JMP	DE2HL1	;and repeat.
                        	  1736: ;
                        	  1737: ;   Select the desired drive.
                        	  1738: ;
01:E75D 3A46E7          	  1739: SELECT	LDA	ACTIVE	;get active disk.
01:E760 4F              	  1740: 	MOV	C,A
01:E761 CD56F3          	  1741: 	CALL	SELDSK	;select it.
01:E764 7C              	  1742: 	MOV	A,H	;valid drive?
01:E765 B5              	  1743: 	ORA	L	;valid drive?
01:E766 C8              	  1744: 	RZ		;return if not.
                        	  1745: ;
                        	  1746: ;   Here, the BIOS returned the address of the parameter block
                        	  1747: ; in (HL). We will extract the necessary pointers and save them.
                        	  1748: ;
01:E767 5E              	  1749: 	MOV	E,M	;yes, get address of translation table into (DE).
01:E768 23              	  1750: 	INX	H
01:E769 56              	  1751: 	MOV	D,M
01:E76A 23              	  1752: 	INX	H
01:E76B 22B7F1          	  1753: 	SHLD	SCRATCH1	;save pointers to scratch areas.
01:E76E 23              	  1754: 	INX	H
01:E76F 23              	  1755: 	INX	H
01:E770 22B9F1          	  1756: 	SHLD	SCRATCH2	;ditto.
01:E773 23              	  1757: 	INX	H
01:E774 23              	  1758: 	INX	H
01:E775 22BBF1          	  1759: 	SHLD	SCRATCH3	;ditto.
01:E778 23              	  1760: 	INX	H
01:E779 23              	  1761: 	INX	H
01:E77A EB              	  1762: 	XCHG		;now save the translation table address.
01:E77B 22D4F1          	  1763: 	SHLD	XLATE
01:E77E 21BDF1          	  1764: 	LXI	H,DIRBUF	;put the next 8 bytes here.
01:E781 0E08            	  1765: 	MVI	C,8	;they consist of the directory buffer
01:E783 CD53E7          	  1766: 	CALL	DE2HL	;pointer, parameter block pointer,
01:E786 2ABFF1          	  1767: 	LHLD	DISKPB	;check and allocation vectors.
01:E789 EB              	  1768: 	XCHG
01:E78A 21C5F1          	  1769: 	LXI	H,SECTORS	;move parameter block into our ram.
01:E78D 0E0F            	  1770: 	MVI	C,15	;it is 15 bytes long.
01:E78F CD53E7          	  1771: 	CALL	DE2HL
01:E792 2ACAF1          	  1772: 	LHLD	DSKSIZE	;check disk size.
01:E795 7C              	  1773: 	MOV	A,H	;more than 256 blocks on this?
01:E796 21E1F1          	  1774: 	LXI	H,BIGDISK
01:E799 36FF            	  1775: 	MVI	M,0FFH	;set to samll.
01:E79B B7              	  1776: 	ORA	A
01:E79C CAA1E7          	  1777: 	JZ	SELECT1
01:E79F 3600            	  1778: 	MVI	M,0	;wrong, set to large.
01:E7A1 3EFF            	  1779: SELECT1	MVI	A,0FFH	;clear the zero flag.
01:E7A3 B7              	  1780: 	ORA	A
01:E7A4 C9              	  1781: 	RET
                        	  1782: ;
                        	  1783: ;   Routine to home the disk track head and clear pointers.
                        	  1784: ;
01:E7A5 CD50F3          	  1785: HOMEDRV	CALL	HOME	;home the head.
01:E7A8 AF              	  1786: 	XRA	A
01:E7A9 2AB9F1          	  1787: 	LHLD	SCRATCH2;set our track pointer also.
01:E7AC 77              	  1788: 	MOV	M,A
01:E7AD 23              	  1789: 	INX	H
01:E7AE 77              	  1790: 	MOV	M,A
01:E7AF 2ABBF1          	  1791: 	LHLD	SCRATCH3;and our sector pointer.
01:E7B2 77              	  1792: 	MOV	M,A
01:E7B3 23              	  1793: 	INX	H
01:E7B4 77              	  1794: 	MOV	M,A
01:E7B5 C9              	  1795: 	RET
                        	  1796: ;
                        	  1797: ;   Do the actual disk read and check the error return status.
                        	  1798: ;
01:E7B6 CDBBF3          	  1799: DOREAD	CALL	READ
01:E7B9 C3BFE7          	  1800: 	JMP	IORET
                        	  1801: ;
                        	  1802: ;   Do the actual disk write and handle any bios error.
                        	  1803: ;
01:E7BC CDC3F3          	  1804: DOWRITE	CALL	WRITE
01:E7BF B7              	  1805: IORET	ORA	A
01:E7C0 C8              	  1806: 	RZ		;return unless an error occured.
01:E7C1 2109E4          	  1807: 	LXI	H,BADSCTR;bad read/write on this sector.
01:E7C4 C34EE7          	  1808: 	JMP	JUMPHL
                        	  1809: ;
                        	  1810: ;   Routine to select the track and sector that the desired
                        	  1811: ; block number falls in.
                        	  1812: ;
01:E7C7 2AEEF1          	  1813: TRKSEC	LHLD	FILEPOS	;get position of last accessed file
01:E7CA 0E02            	  1814: 	MVI	C,2	;in directory and compute sector #.
01:E7CC CDEEE8          	  1815: 	CALL	SHIFTR	;sector #=file-position/4.
01:E7CF 22E9F1          	  1816: 	SHLD	BLKNMBR	;save this as the block number of interest.
01:E7D2 22F0F1          	  1817: 	SHLD	CKSUMTBL;what's it doing here too?
                        	  1818: ;
                        	  1819: ;   if the sector number has already been set (BLKNMBR), enter
                        	  1820: ; at this point.
                        	  1821: ;
01:E7D5 21E9F1          	  1822: TRKSEC1	LXI	H,BLKNMBR
01:E7D8 4E              	  1823: 	MOV	C,M	;move sector number into (BC).
01:E7D9 23              	  1824: 	INX	H
01:E7DA 46              	  1825: 	MOV	B,M
01:E7DB 2ABBF1          	  1826: 	LHLD	SCRATCH3;get current sector number and
01:E7DE 5E              	  1827: 	MOV	E,M	;move this into (DE).
01:E7DF 23              	  1828: 	INX	H
01:E7E0 56              	  1829: 	MOV	D,M
01:E7E1 2AB9F1          	  1830: 	LHLD	SCRATCH2;get current track number.
01:E7E4 7E              	  1831: 	MOV	A,M	;and this into (HL).
01:E7E5 23              	  1832: 	INX	H
01:E7E6 66              	  1833: 	MOV	H,M
01:E7E7 6F              	  1834: 	MOV	L,A
01:E7E8 79              	  1835: TRKSEC2	MOV	A,C	;is desired sector before current one?
01:E7E9 93              	  1836: 	SUB	E
01:E7EA 78              	  1837: 	MOV	A,B
01:E7EB 9A              	  1838: 	SBB	D
01:E7EC D2FEE7          	  1839: 	JNC	TRKSEC3
01:E7EF E5              	  1840: 	PUSH	H	;yes, decrement sectors by one track.
01:E7F0 2AC5F1          	  1841: 	LHLD	SECTORS	;get sectors per track.
01:E7F3 7B              	  1842: 	MOV	A,E
01:E7F4 95              	  1843: 	SUB	L
01:E7F5 5F              	  1844: 	MOV	E,A
01:E7F6 7A              	  1845: 	MOV	A,D
01:E7F7 9C              	  1846: 	SBB	H
01:E7F8 57              	  1847: 	MOV	D,A	;now we have backed up one full track.
01:E7F9 E1              	  1848: 	POP	H
01:E7FA 2B              	  1849: 	DCX	H	;adjust track counter.
01:E7FB C3E8E7          	  1850: 	JMP	TRKSEC2
01:E7FE E5              	  1851: TRKSEC3	PUSH	H	;desired sector is after current one.
01:E7FF 2AC5F1          	  1852: 	LHLD	SECTORS	;get sectors per track.
01:E802 19              	  1853: 	DAD	D	;bump sector pointer to next track.
01:E803 DA13E8          	  1854: 	JC	TRKSEC4
01:E806 79              	  1855: 	MOV	A,C	;is desired sector now before current one?
01:E807 95              	  1856: 	SUB	L
01:E808 78              	  1857: 	MOV	A,B
01:E809 9C              	  1858: 	SBB	H
01:E80A DA13E8          	  1859: 	JC	TRKSEC4
01:E80D EB              	  1860: 	XCHG		;not yes, increment track counter
01:E80E E1              	  1861: 	POP	H	;and continue until it is.
01:E80F 23              	  1862: 	INX	H
01:E810 C3FEE7          	  1863: 	JMP	TRKSEC3
                        	  1864: ;
                        	  1865: ;   here we have determined the track number that contains the
                        	  1866: ; desired sector.
                        	  1867: ;
01:E813 E1              	  1868: TRKSEC4	POP	H	;get track number (HL).
01:E814 C5              	  1869: 	PUSH	B
01:E815 D5              	  1870: 	PUSH	D
01:E816 E5              	  1871: 	PUSH	H
01:E817 EB              	  1872: 	XCHG
01:E818 2AD2F1          	  1873: 	LHLD	OFFSET	;adjust for first track offset.
01:E81B 19              	  1874: 	DAD	D
01:E81C 44              	  1875: 	MOV	B,H
01:E81D 4D              	  1876: 	MOV	C,L
01:E81E CD75F3          	  1877: 	CALL	SETTRK	;select this track.
01:E821 D1              	  1878: 	POP	D	;reset current track pointer.
01:E822 2AB9F1          	  1879: 	LHLD	SCRATCH2
01:E825 73              	  1880: 	MOV	M,E
01:E826 23              	  1881: 	INX	H
01:E827 72              	  1882: 	MOV	M,D
01:E828 D1              	  1883: 	POP	D
01:E829 2ABBF1          	  1884: 	LHLD	SCRATCH3;reset the first sector on this track.
01:E82C 73              	  1885: 	MOV	M,E
01:E82D 23              	  1886: 	INX	H
01:E82E 72              	  1887: 	MOV	M,D
01:E82F C1              	  1888: 	POP	B
01:E830 79              	  1889: 	MOV	A,C	;now subtract the desired one.
01:E831 93              	  1890: 	SUB	E	;to make it relative (1-# sectors/track).
01:E832 4F              	  1891: 	MOV	C,A
01:E833 78              	  1892: 	MOV	A,B
01:E834 9A              	  1893: 	SBB	D
01:E835 47              	  1894: 	MOV	B,A
01:E836 2AD4F1          	  1895: 	LHLD	XLATE	;translate this sector according to this table.
01:E839 EB              	  1896: 	XCHG
01:E83A CD9FF3          	  1897: 	CALL	SECTRN	;let the bios translate it.
01:E83D 4D              	  1898: 	MOV	C,L
01:E83E 44              	  1899: 	MOV	B,H
01:E83F C38AF3          	  1900: 	JMP	SETSEC	;and select it.
                        	  1901: ;
                        	  1902: ;   Compute block number from record number (SAVNREC) and
                        	  1903: ; extent number (SAVEXT).
                        	  1904: ;
01:E842 21C7F1          	  1905: GETBLOCK:LXI	H,BLKSHFT;get logical to physical conversion.
01:E845 4E              	  1906: 	MOV	C,M	;note that this is base 2 log of ratio.
01:E846 3AE7F1          	  1907: 	LDA	SAVNREC	;get record number.
01:E849 B7              	  1908: GETBLK1	ORA	A	;compute (A)=(A)/2^BLKSHFT.
01:E84A 1F              	  1909: 	RAR
01:E84B 0D              	  1910: 	DCR	C
01:E84C C249E8          	  1911: 	JNZ	GETBLK1
01:E84F 47              	  1912: 	MOV	B,A	;save result in (B).
01:E850 3E08            	  1913: 	MVI	A,8
01:E852 96              	  1914: 	SUB	M
01:E853 4F              	  1915: 	MOV	C,A	;compute (C)=8-BLKSHFT.
01:E854 3AE6F1          	  1916: 	LDA	SAVEXT
01:E857 0D              	  1917: GETBLK2	DCR	C	;compute (A)=SAVEXT*2^(8-BLKSHFT).
01:E858 CA60E8          	  1918: 	JZ	GETBLK3
01:E85B B7              	  1919: 	ORA	A
01:E85C 17              	  1920: 	RAL
01:E85D C357E8          	  1921: 	JMP	GETBLK2
01:E860 80              	  1922: GETBLK3	ADD	B
01:E861 C9              	  1923: 	RET
                        	  1924: ;
                        	  1925: ;   Routine to extract the (BC) block byte from the fcb pointed
                        	  1926: ; to by (PARAMS). If this is a big-disk, then these are 16 bit
                        	  1927: ; block numbers, else they are 8 bit numbers.
                        	  1928: ; Number is returned in (HL).
                        	  1929: ;
01:E862 2A47E7          	  1930: EXTBLK	LHLD	PARAMS	;get fcb address.
01:E865 111000          	  1931: 	LXI	D,16	;block numbers start 16 bytes into fcb.
01:E868 19              	  1932: 	DAD	D
01:E869 09              	  1933: 	DAD	B
01:E86A 3AE1F1          	  1934: 	LDA	BIGDISK	;are we using a big-disk?
01:E86D B7              	  1935: 	ORA	A
01:E86E CA75E8          	  1936: 	JZ	EXTBLK1
01:E871 6E              	  1937: 	MOV	L,M	;no, extract an 8 bit number from the fcb.
01:E872 2600            	  1938: 	MVI	H,0
01:E874 C9              	  1939: 	RET
01:E875 09              	  1940: EXTBLK1	DAD	B	;yes, extract a 16 bit number.
01:E876 5E              	  1941: 	MOV	E,M
01:E877 23              	  1942: 	INX	H
01:E878 56              	  1943: 	MOV	D,M
01:E879 EB              	  1944: 	XCHG		;return in (HL).
01:E87A C9              	  1945: 	RET
                        	  1946: ;
                        	  1947: ;   Compute block number.
                        	  1948: ;
01:E87B CD42E8          	  1949: COMBLK	CALL	GETBLOCK
01:E87E 4F              	  1950: 	MOV	C,A
01:E87F 0600            	  1951: 	MVI	B,0
01:E881 CD62E8          	  1952: 	CALL	EXTBLK
01:E884 22E9F1          	  1953: 	SHLD	BLKNMBR
01:E887 C9              	  1954: 	RET
                        	  1955: ;
                        	  1956: ;   Check for a zero block number (unused).
                        	  1957: ;
01:E888 2AE9F1          	  1958: CHKBLK	LHLD	BLKNMBR
01:E88B 7D              	  1959: 	MOV	A,L	;is it zero?
01:E88C B4              	  1960: 	ORA	H
01:E88D C9              	  1961: 	RET
                        	  1962: ;
                        	  1963: ;   Adjust physical block (BLKNMBR) and convert to logical
                        	  1964: ; sector (LOGSECT). This is the starting sector of this block.
                        	  1965: ; The actual sector of interest is then added to this and the
                        	  1966: ; resulting sector number is stored back in (BLKNMBR). This
                        	  1967: ; will still have to be adjusted for the track number.
                        	  1968: ;
01:E88E 3AC7F1          	  1969: LOGICAL	LDA	BLKSHFT	;get log2(physical/logical sectors).
01:E891 2AE9F1          	  1970: 	LHLD	BLKNMBR	;get physical sector desired.
01:E894 29              	  1971: LOGICL1	DAD	H	;compute logical sector number.
01:E895 3D              	  1972: 	DCR	A	;note logical sectors are 128 bytes long.
01:E896 C294E8          	  1973: 	JNZ	LOGICL1
01:E899 22EBF1          	  1974: 	SHLD	LOGSECT	;save logical sector.
01:E89C 3AC8F1          	  1975: 	LDA	BLKMASK	;get block mask.
01:E89F 4F              	  1976: 	MOV	C,A
01:E8A0 3AE7F1          	  1977: 	LDA	SAVNREC	;get next sector to access.
01:E8A3 A1              	  1978: 	ANA	C	;extract the relative position within physical block.
01:E8A4 B5              	  1979: 	ORA	L	;and add it too logical sector.
01:E8A5 6F              	  1980: 	MOV	L,A
01:E8A6 22E9F1          	  1981: 	SHLD	BLKNMBR	;and store.
01:E8A9 C9              	  1982: 	RET
                        	  1983: ;
                        	  1984: ;   Set (HL) to point to extent byte in fcb.
                        	  1985: ;
01:E8AA 2A47E7          	  1986: SETEXT	LHLD	PARAMS
01:E8AD 110C00          	  1987: 	LXI	D,12	;it is the twelth byte.
01:E8B0 19              	  1988: 	DAD	D
01:E8B1 C9              	  1989: 	RET
                        	  1990: ;
                        	  1991: ;   Set (HL) to point to record count byte in fcb and (DE) to
                        	  1992: ; next record number byte.
                        	  1993: ;
01:E8B2 2A47E7          	  1994: SETHLDE	LHLD	PARAMS
01:E8B5 110F00          	  1995: 	LXI	D,15	;record count byte (#15).
01:E8B8 19              	  1996: 	DAD	D
01:E8B9 EB              	  1997: 	XCHG
01:E8BA 211100          	  1998: 	LXI	H,17	;next record number (#32).
01:E8BD 19              	  1999: 	DAD	D
01:E8BE C9              	  2000: 	RET
                        	  2001: ;
                        	  2002: ;   Save current file data from fcb.
                        	  2003: ;
01:E8BF CDB2E8          	  2004: STRDATA	CALL	SETHLDE
01:E8C2 7E              	  2005: 	MOV	A,M	;get and store record count byte.
01:E8C3 32E7F1          	  2006: 	STA	SAVNREC
01:E8C6 EB              	  2007: 	XCHG
01:E8C7 7E              	  2008: 	MOV	A,M	;get and store next record number byte.
01:E8C8 32E5F1          	  2009: 	STA	SAVNXT
01:E8CB CDAAE8          	  2010: 	CALL	SETEXT	;point to extent byte.
01:E8CE 3AC9F1          	  2011: 	LDA	EXTMASK	;get extent mask.
01:E8D1 A6              	  2012: 	ANA	M
01:E8D2 32E6F1          	  2013: 	STA	SAVEXT	;and save extent here.
01:E8D5 C9              	  2014: 	RET
                        	  2015: ;
                        	  2016: ;   Set the next record to access. If (MODE) is set to 2, then
                        	  2017: ; the last record byte (SAVNREC) has the correct number to access.
                        	  2018: ; For sequential access, (MODE) will be equal to 1.
                        	  2019: ;
01:E8D6 CDB2E8          	  2020: SETNREC	CALL	SETHLDE
01:E8D9 3AD9F1          	  2021: 	LDA	MODE	;get sequential flag (=1).
01:E8DC FE02            	  2022: 	CPI	2	;a 2 indicates that no adder is needed.
01:E8DE C2E2E8          	  2023: 	JNZ	STNREC1
01:E8E1 AF              	  2024: 	XRA	A	;clear adder (random access?).
01:E8E2 4F              	  2025: STNREC1	MOV	C,A
01:E8E3 3AE7F1          	  2026: 	LDA	SAVNREC	;get last record number.
01:E8E6 81              	  2027: 	ADD	C	;increment record count.
01:E8E7 77              	  2028: 	MOV	M,A	;and set fcb's next record byte.
01:E8E8 EB              	  2029: 	XCHG
01:E8E9 3AE5F1          	  2030: 	LDA	SAVNXT	;get next record byte from storage.
01:E8EC 77              	  2031: 	MOV	M,A	;and put this into fcb as number of records used.
01:E8ED C9              	  2032: 	RET
                        	  2033: ;
                        	  2034: ;   Shift (HL) right (C) bits.
                        	  2035: ;
01:E8EE 0C              	  2036: SHIFTR	INR	C
01:E8EF 0D              	  2037: SHIFTR1	DCR	C
01:E8F0 C8              	  2038: 	RZ
01:E8F1 7C              	  2039: 	MOV	A,H
01:E8F2 B7              	  2040: 	ORA	A
01:E8F3 1F              	  2041: 	RAR
01:E8F4 67              	  2042: 	MOV	H,A
01:E8F5 7D              	  2043: 	MOV	A,L
01:E8F6 1F              	  2044: 	RAR
01:E8F7 6F              	  2045: 	MOV	L,A
01:E8F8 C3EFE8          	  2046: 	JMP	SHIFTR1
                        	  2047: ;
                        	  2048: ;   Compute the check-sum for the directory buffer. Return
                        	  2049: ; integer sum in (A).
                        	  2050: ;
01:E8FB 0E80            	  2051: CHECKSUM:MVI	C,128	;length of buffer.
01:E8FD 2ABDF1          	  2052: 	LHLD	DIRBUF	;get its location.
01:E900 AF              	  2053: 	XRA	A	;clear summation byte.
01:E901 86              	  2054: CHKSUM1	ADD	M	;and compute sum ignoring carries.
01:E902 23              	  2055: 	INX	H
01:E903 0D              	  2056: 	DCR	C
01:E904 C201E9          	  2057: 	JNZ	CHKSUM1
01:E907 C9              	  2058: 	RET
                        	  2059: ;
                        	  2060: ;   Shift (HL) left (C) bits.
                        	  2061: ;
01:E908 0C              	  2062: SHIFTL	INR	C
01:E909 0D              	  2063: SHIFTL1	DCR	C
01:E90A C8              	  2064: 	RZ
01:E90B 29              	  2065: 	DAD	H	;shift left 1 bit.
01:E90C C309E9          	  2066: 	JMP	SHIFTL1
                        	  2067: ;
                        	  2068: ;   Routine to set a bit in a 16 bit value contained in (BC).
                        	  2069: ; The bit set depends on the current drive selection.
                        	  2070: ;
01:E90F C5              	  2071: SETBIT	PUSH	B	;save 16 bit word.
01:E910 3A46E7          	  2072: 	LDA	ACTIVE	;get active drive.
01:E913 4F              	  2073: 	MOV	C,A
01:E914 210100          	  2074: 	LXI	H,1
