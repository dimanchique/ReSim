01:EA3A E607            	  2327: 	ANI	07H	;compute (D)=(E)=(C and 7)+1.
01:EA3C 3C              	  2328: 	INR	A
01:EA3D 5F              	  2329: 	MOV	E,A	;save particular bit number.
01:EA3E 57              	  2330: 	MOV	D,A
                        	  2331: ;
