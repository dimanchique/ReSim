01:E9F4 0E80            	  2270: 	MVI	C,128	;this is its length.
01:E9F6 C353E7          	  2271: 	JMP	DE2HL	;move it now and return.
                        	  2272: ;
                        	  2273: ;   Check (FILEPOS) and set the zero flag if it equals 0ffffh.
                        	  2274: ;
