01:E5F0 E5              	  1516: 	PUSH	H	;and save.
01:E5F1 0600            	  1517: 	MVI	B,0	;keep a character count.
01:E5F3 C5              	  1518: RDBUF1	PUSH	B
01:E5F4 E5              	  1519: 	PUSH	H
01:E5F5 CDFFE4          	  1520: RDBUF2	CALL	GETCHAR	;get the next input character.
01:E5F8 E67F            	  1521: 	ANI	7FH	;strip bit 7.
01:E5FA E1              	  1522: 	POP	H	;reset registers.
01:E5FB C1              	  1523: 	POP	B
01:E5FC FE0D            	  1524: 	CPI	CR	;en of the line?
01:E5FE CAC5E6          	  1525: 	JZ	RDBUF17
01:E601 FE0A            	  1526: 	CPI	LF
01:E603 CAC5E6          	  1527: 	JZ	RDBUF17
01:E606 FE08            	  1528: 	CPI	BS	;how about a backspace?
01:E608 C21AE6          	  1529: 	JNZ	RDBUF3
01:E60B 78              	  1530: 	MOV	A,B	;yes, but ignore at the beginning of the line.
01:E60C B7              	  1531: 	ORA	A
01:E60D CAF3E5          	  1532: 	JZ	RDBUF1
01:E610 05              	  1533: 	DCR	B	;ok, update counter.
01:E611 3A10E7          	  1534: 	LDA	CURPOS	;if we backspace to the start of the line,
01:E614 320EE7          	  1535: 	STA	OUTFLAG	;treat as a cancel (control-x).
01:E617 C374E6          	  1536: 	JMP	RDBUF10
01:E61A FE7F            	  1537: RDBUF3	CPI	DEL	;user typed a rubout?
01:E61C C22AE6          	  1538: 	JNZ	RDBUF4
01:E61F 78              	  1539: 	MOV	A,B	;ignore at the start of the line.
01:E620 B7              	  1540: 	ORA	A
01:E621 CAF3E5          	  1541: 	JZ	RDBUF1
01:E624 7E              	  1542: 	MOV	A,M	;ok, echo the prevoius character.
01:E625 05              	  1543: 	DCR	B	;and reset pointers (counters).
01:E626 2B              	  1544: 	DCX	H
01:E627 C3ADE6          	  1545: 	JMP	RDBUF15
01:E62A FE05            	  1546: RDBUF4	CPI	CNTRLE	;physical end of line?
01:E62C C23BE6          	  1547: 	JNZ	RDBUF5
01:E62F C5              	  1548: 	PUSH	B	;yes, do it.
01:E630 E5              	  1549: 	PUSH	H
01:E631 CDCDE5          	  1550: 	CALL	OUTCRLF
01:E634 AF              	  1551: 	XRA	A	;and update starting position.
01:E635 320FE7          	  1552: 	STA	STARTING
01:E638 C3F5E5          	  1553: 	JMP	RDBUF2
01:E63B FE10            	  1554: RDBUF5	CPI	CNTRLP	;control-p?
01:E63D C24CE6          	  1555: 	JNZ	RDBUF6
01:E640 E5              	  1556: 	PUSH	H	;yes, flip the print flag filp-flop byte.
01:E641 2111E7          	  1557: 	LXI	H,PRTFLAG
01:E644 3E01            	  1558: 	MVI	A,1	;PRTFLAG=1-PRTFLAG
01:E646 96              	  1559: 	SUB	M
01:E647 77              	  1560: 	MOV	M,A
01:E648 E1              	  1561: 	POP	H
01:E649 C3F3E5          	  1562: 	JMP	RDBUF1
01:E64C FE18            	  1563: RDBUF6	CPI	CNTRLX	;control-x (cancel)?
01:E64E C263E6          	  1564: 	JNZ	RDBUF8
01:E651 E1              	  1565: 	POP	H
01:E652 3A0FE7          	  1566: RDBUF7	LDA	STARTING;yes, backup the cursor to here.
01:E655 2110E7          	  1567: 	LXI	H,CURPOS
01:E658 BE              	  1568: 	CMP	M
01:E659 D2E5E5          	  1569: 	JNC	RDBUFF	;done yet?
01:E65C 35              	  1570: 	DCR	M	;no, decrement pointer and output back up one space.
01:E65D CDA8E5          	  1571: 	CALL	BACKUP
01:E660 C352E6          	  1572: 	JMP	RDBUF7
01:E663 FE15            	  1573: RDBUF8	CPI	CNTRLU	;cntrol-u (cancel line)?
01:E665 C26FE6          	  1574: 	JNZ	RDBUF9
01:E668 CDB5E5          	  1575: 	CALL	NEWLINE	;start a new line.
01:E66B E1              	  1576: 	POP	H
01:E66C C3E5E5          	  1577: 	JMP	RDBUFF
01:E66F FE12            	  1578: RDBUF9	CPI	CNTRLR	;control-r?
01:E671 C2AAE6          	  1579: 	JNZ	RDBUF14
01:E674 C5              	  1580: RDBUF10	PUSH	B	;yes, start a new line and retype the old one.
01:E675 CDB5E5          	  1581: 	CALL	NEWLINE
01:E678 C1              	  1582: 	POP	B
01:E679 E1              	  1583: 	POP	H
01:E67A E5              	  1584: 	PUSH	H
01:E67B C5              	  1585: 	PUSH	B
01:E67C 78              	  1586: RDBUF11	MOV	A,B	;done whole line yet?
01:E67D B7              	  1587: 	ORA	A
01:E67E CA8EE6          	  1588: 	JZ	RDBUF12
01:E681 23              	  1589: 	INX	H	;nope, get next character.
01:E682 4E              	  1590: 	MOV	C,M
01:E683 05              	  1591: 	DCR	B	;count it.
01:E684 C5              	  1592: 	PUSH	B
01:E685 E5              	  1593: 	PUSH	H
01:E686 CD83E5          	  1594: 	CALL	SHOWIT	;and display it.
01:E689 E1              	  1595: 	POP	H
01:E68A C1              	  1596: 	POP	B
01:E68B C37CE6          	  1597: 	JMP	RDBUF11
01:E68E E5              	  1598: RDBUF12	PUSH	H	;done with line. If we were displaying
01:E68F 3A0EE7          	  1599: 	LDA	OUTFLAG	;then update cursor position.
01:E692 B7              	  1600: 	ORA	A
01:E693 CAF5E5          	  1601: 	JZ	RDBUF2
01:E696 2110E7          	  1602: 	LXI	H,CURPOS;because this line is shorter, we must
01:E699 96              	  1603: 	SUB	M	;back up the cursor (not the screen however)
01:E69A 320EE7          	  1604: 	STA	OUTFLAG	;some number of positions.
01:E69D CDA8E5          	  1605: RDBUF13	CALL	BACKUP	;note that as long as (OUTFLAG) is non
01:E6A0 210EE7          	  1606: 	LXI	H,OUTFLAG;zero, the screen will not be changed.
01:E6A3 35              	  1607: 	DCR	M
01:E6A4 C29DE6          	  1608: 	JNZ	RDBUF13
01:E6A7 C3F5E5          	  1609: 	JMP	RDBUF2	;now just get the next character.
                        	  1610: ;
                        	  1611: ;   Just a normal character, put this in our buffer and echo.
                        	  1612: ;
01:E6AA 23              	  1613: RDBUF14	INX	H
01:E6AB 77              	  1614: 	MOV	M,A	;store character.
01:E6AC 04              	  1615: 	INR	B	;and count it.
01:E6AD C5              	  1616: RDBUF15	PUSH	B
01:E6AE E5              	  1617: 	PUSH	H
01:E6AF 4F              	  1618: 	MOV	C,A	;echo it now.
01:E6B0 CD83E5          	  1619: 	CALL	SHOWIT
01:E6B3 E1              	  1620: 	POP	H
01:E6B4 C1              	  1621: 	POP	B
01:E6B5 7E              	  1622: 	MOV	A,M	;was it an abort request?
01:E6B6 FE03            	  1623: 	CPI	CNTRLC	;control-c abort?
01:E6B8 78              	  1624: 	MOV	A,B
01:E6B9 C2C1E6          	  1625: 	JNZ	RDBUF16
