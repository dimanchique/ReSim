01:EAA1 E1              	  2422: SETFL4	POP	H	;point to next block number in fcb.
01:EAA2 23              	  2423: 	INX	H
01:EAA3 C1              	  2424: 	POP	B
01:EAA4 C379EA          	  2425: 	JMP	SETFL1
                        	  2426: ;
                        	  2427: ;   Construct the space used allocation bit map for the active
                        	  2428: ; drive. If a file name starts with '$' and it is under the
                        	  2429: ; current user number, then (STATUS) is set to minus 1. Otherwise
                        	  2430: ; it is not set at all.
                        	  2431: ;
01:EAA7 2ACAF1          	  2432: BITMAP	LHLD	DSKSIZE	;compute size of allocation table.
01:EAAA 0E03            	  2433: 	MVI	C,3
01:EAAC CDEEE8          	  2434: 	CALL	SHIFTR	;(HL)=(HL)/8.
01:EAAF 23              	  2435: 	INX	H	;at lease 1 byte.
01:EAB0 44              	  2436: 	MOV	B,H
01:EAB1 4D              	  2437: 	MOV	C,L	;set (BC) to the allocation table length.
                        	  2438: ;
                        	  2439: ;   Initialize the bitmap for this drive. Right now, the first
                        	  2440: ; two bytes are specified by the disk parameter block. However
                        	  2441: ; a patch could be entered here if it were necessary to setup
                        	  2442: ; this table in a special mannor. For example, the bios could
                        	  2443: ; determine locations of 'bad blocks' and set them as already
                        	  2444: ; 'used' in the map.
                        	  2445: ;
01:EAB2 2AC3F1          	  2446: 	LHLD	ALOCVECT;now zero out the table now.
01:EAB5 3600            	  2447: BITMAP1	MVI	M,0
01:EAB7 23              	  2448: 	INX	H
01:EAB8 0B              	  2449: 	DCX	B
01:EAB9 78              	  2450: 	MOV	A,B
01:EABA B1              	  2451: 	ORA	C
01:EABB C2B5EA          	  2452: 	JNZ	BITMAP1
01:EABE 2ACEF1          	  2453: 	LHLD	ALLOC0	;get initial space used by directory.
01:EAC1 EB              	  2454: 	XCHG
01:EAC2 2AC3F1          	  2455: 	LHLD	ALOCVECT;and put this into map.
01:EAC5 73              	  2456: 	MOV	M,E
01:EAC6 23              	  2457: 	INX	H
01:EAC7 72              	  2458: 	MOV	M,D
                        	  2459: ;
                        	  2460: ;   End of initialization portion.
                        	  2461: ;
01:EAC8 CDA5E7          	  2462: 	CALL	HOMEDRV	;now home the drive.
01:EACB 2AB7F1          	  2463: 	LHLD	SCRATCH1
01:EACE 3603            	  2464: 	MVI	M,3	;force next directory request to read
01:EAD0 23              	  2465: 	INX	H	;in a sector.
01:EAD1 3600            	  2466: 	MVI	M,0
01:EAD3 CD02EA          	  2467: 	CALL	STFILPOS;clear initial file position also.
01:EAD6 0EFF            	  2468: BITMAP2	MVI	C,0FFH	;read next file name in directory
01:EAD8 CD09EA          	  2469: 	CALL	NXENTRY	;and set checksum byte.
01:EADB CDF9E9          	  2470: 	CALL	CKFILPOS;is there another file?
01:EADE C8              	  2471: 	RZ
01:EADF CD62E9          	  2472: 	CALL	FCB2HL	;yes, get its address.
01:EAE2 3EE5            	  2473: 	MVI	A,0E5H
01:EAE4 BE              	  2474: 	CMP	M	;empty file entry?
01:EAE5 CAD6EA          	  2475: 	JZ	BITMAP2
01:EAE8 3A45E7          	  2476: 	LDA	USERNO	;no, correct user number?
01:EAEB BE              	  2477: 	CMP	M
01:EAEC C2FAEA          	  2478: 	JNZ	BITMAP3
01:EAEF 23              	  2479: 	INX	H
01:EAF0 7E              	  2480: 	MOV	A,M	;yes, does name start with a '$'?
01:EAF1 D624            	  2481: 	SUI	'$'
01:EAF3 C2FAEA          	  2482: 	JNZ	BITMAP3
01:EAF6 3D              	  2483: 	DCR	A	;yes, set atatus to minus one.
01:EAF7 3249E7          	  2484: 	STA	STATUS
01:EAFA 0E01            	  2485: BITMAP3	MVI	C,1	;now set this file's space as used in bit map.
01:EAFC CD6FEA          	  2486: 	CALL	SETFILE
01:EAFF CD90E9          	  2487: 	CALL	CHKNMBR	;keep (SCRATCH1) in bounds.
01:EB02 C3D6EA          	  2488: 	JMP	BITMAP2
                        	  2489: ;
                        	  2490: ;   Set the status (STATUS) and return.
                        	  2491: ;
01:EB05 3AD8F1          	  2492: STSTATUS:LDA	FNDSTAT
01:EB08 C305E7          	  2493: 	JMP	SETSTAT
                        	  2494: ;
                        	  2495: ;   Check extents in (A) and (C). Set the zero flag if they
                        	  2496: ; are the same. The number of 16k chunks of disk space that
                        	  2497: ; the directory extent covers is expressad is (EXTMASK+1).
                        	  2498: ; No registers are modified.
                        	  2499: ;
01:EB0B C5              	  2500: SAMEXT	PUSH	B
01:EB0C F5              	  2501: 	PUSH	PSW
01:EB0D 3AC9F1          	  2502: 	LDA	EXTMASK	;get extent mask and use it to
01:EB10 2F              	  2503: 	CMA		;to compare both extent numbers.
01:EB11 47              	  2504: 	MOV	B,A	;save resulting mask here.
01:EB12 79              	  2505: 	MOV	A,C	;mask first extent and save in (C).
01:EB13 A0              	  2506: 	ANA	B
01:EB14 4F              	  2507: 	MOV	C,A
01:EB15 F1              	  2508: 	POP	PSW	;now mask second extent and compare
01:EB16 A0              	  2509: 	ANA	B	;with the first one.
01:EB17 91              	  2510: 	SUB	C
01:EB18 E61F            	  2511: 	ANI	1FH	;(* only check buts 0-4 *)
01:EB1A C1              	  2512: 	POP	B	;the zero flag is set if they are the same.
01:EB1B C9              	  2513: 	RET		;restore (BC) and return.
                        	  2514: ;
                        	  2515: ;   Search for the first occurence of a file name. On entry,
                        	  2516: ; register (C) should contain the number of bytes of the fcb
                        	  2517: ; that must match.
                        	  2518: ;
01:EB1C 3EFF            	  2519: FINDFST	MVI	A,0FFH
01:EB1E 32D8F1          	  2520: 	STA	FNDSTAT
01:EB21 21DCF1          	  2521: 	LXI	H,COUNTER;save character count.
01:EB24 71              	  2522: 	MOV	M,C
01:EB25 2A47E7          	  2523: 	LHLD	PARAMS	;get filename to match.
01:EB28 22DDF1          	  2524: 	SHLD	SAVEFCB	;and save.
01:EB2B CD02EA          	  2525: 	CALL	STFILPOS;clear initial file position (set to 0ffffh).
01:EB2E CDA5E7          	  2526: 	CALL	HOMEDRV	;home the drive.
                        	  2527: ;
                        	  2528: ;   Entry to locate the next occurence of a filename within the
                        	  2529: ; directory. The disk is not expected to have been changed. If
                        	  2530: ; it was, then it will be write protected.
                        	  2531: ;
01:EB31 0E00            	  2532: FINDNXT	MVI	C,0	;write protect the disk if changed.
01:EB33 CD09EA          	  2533: 	CALL	NXENTRY	;get next filename entry in directory.
01:EB36 CDF9E9          	  2534: 	CALL	CKFILPOS;is file position = 0ffffh?
01:EB39 CA98EB          	  2535: 	JZ	FNDNXT6	;yes, exit now then.
01:EB3C 2ADDF1          	  2536: 	LHLD	SAVEFCB	;set (DE) pointing to filename to match.
01:EB3F EB              	  2537: 	XCHG
01:EB40 1A              	  2538: 	LDAX	D
01:EB41 FEE5            	  2539: 	CPI	0E5H	;empty directory entry?
01:EB43 CA4EEB          	  2540: 	JZ	FNDNXT1	;(* are we trying to reserect erased entries? *)
01:EB46 D5              	  2541: 	PUSH	D
01:EB47 CD83E9          	  2542: 	CALL	MOREFLS	;more files in directory?
01:EB4A D1              	  2543: 	POP	D
01:EB4B D298EB          	  2544: 	JNC	FNDNXT6	;no more. Exit now.
01:EB4E CD62E9          	  2545: FNDNXT1	CALL	FCB2HL	;get address of this fcb in directory.
01:EB51 3ADCF1          	  2546: 	LDA	COUNTER	;get number of bytes (characters) to check.
01:EB54 4F              	  2547: 	MOV	C,A
01:EB55 0600            	  2548: 	MVI	B,0	;initialize byte position counter.
01:EB57 79              	  2549: FNDNXT2	MOV	A,C	;are we done with the compare?
01:EB58 B7              	  2550: 	ORA	A
01:EB59 CA87EB          	  2551: 	JZ	FNDNXT5
01:EB5C 1A              	  2552: 	LDAX	D	;no, check next byte.
01:EB5D FE3F            	  2553: 	CPI	'?'	;don't care about this character?
01:EB5F CA80EB          	  2554: 	JZ	FNDNXT4
01:EB62 78              	  2555: 	MOV	A,B	;get bytes position in fcb.
01:EB63 FE0D            	  2556: 	CPI	13	;don't care about the thirteenth byte either.
01:EB65 CA80EB          	  2557: 	JZ	FNDNXT4
01:EB68 FE0C            	  2558: 	CPI	12	;extent byte?
01:EB6A 1A              	  2559: 	LDAX	D
01:EB6B CA77EB          	  2560: 	JZ	FNDNXT3
01:EB6E 96              	  2561: 	SUB	M	;otherwise compare characters.
01:EB6F E67F            	  2562: 	ANI	7FH
01:EB71 C231EB          	  2563: 	JNZ	FINDNXT	;not the same, check next entry.
01:EB74 C380EB          	  2564: 	JMP	FNDNXT4	;so far so good, keep checking.
01:EB77 C5              	  2565: FNDNXT3	PUSH	B	;check the extent byte here.
01:EB78 4E              	  2566: 	MOV	C,M
01:EB79 CD0BEB          	  2567: 	CALL	SAMEXT
01:EB7C C1              	  2568: 	POP	B
01:EB7D C231EB          	  2569: 	JNZ	FINDNXT	;not the same, look some more.
                        	  2570: ;
                        	  2571: ;   So far the names compare. Bump pointers to the next byte
                        	  2572: ; and continue until all (C) characters have been checked.
                        	  2573: ;
01:EB80 13              	  2574: FNDNXT4	INX	D	;bump pointers.
01:EB81 23              	  2575: 	INX	H
01:EB82 04              	  2576: 	INR	B
01:EB83 0D              	  2577: 	DCR	C	;adjust character counter.
01:EB84 C357EB          	  2578: 	JMP	FNDNXT2
01:EB87 3AEEF1          	  2579: FNDNXT5	LDA	FILEPOS	;return the position of this entry.
01:EB8A E603            	  2580: 	ANI	03H
01:EB8C 3249E7          	  2581: 	STA	STATUS
01:EB8F 21D8F1          	  2582: 	LXI	H,FNDSTAT
01:EB92 7E              	  2583: 	MOV	A,M
01:EB93 17              	  2584: 	RAL
01:EB94 D0              	  2585: 	RNC
01:EB95 AF              	  2586: 	XRA	A
01:EB96 77              	  2587: 	MOV	M,A
01:EB97 C9              	  2588: 	RET
                        	  2589: ;
                        	  2590: ;   Filename was not found. Set appropriate status.
                        	  2591: ;
01:EB98 CD02EA          	  2592: FNDNXT6	CALL	STFILPOS;set (FILEPOS) to 0ffffh.
01:EB9B 3EFF            	  2593: 	MVI	A,0FFH	;say not located.
01:EB9D C305E7          	  2594: 	JMP	SETSTAT
                        	  2595: ;
                        	  2596: ;   Erase files from the directory. Only the first byte of the
                        	  2597: ; fcb will be affected. It is set to (E5).
                        	  2598: ;
01:EBA0 CD58E9          	  2599: ERAFILE	CALL	CHKWPRT	;is disk write protected?
01:EBA3 0E0C            	  2600: 	MVI	C,12	;only compare file names.
01:EBA5 CD1CEB          	  2601: 	CALL	FINDFST	;get first file name.
01:EBA8 CDF9E9          	  2602: ERAFIL1	CALL	CKFILPOS;any found?
01:EBAB C8              	  2603: 	RZ		;nope, we must be done.
01:EBAC CD48E9          	  2604: 	CALL	CHKROFL	;is file read only?
01:EBAF CD62E9          	  2605: 	CALL	FCB2HL	;nope, get address of fcb and
01:EBB2 36E5            	  2606: 	MVI	M,0E5H	;set first byte to 'empty'.
01:EBB4 0E00            	  2607: 	MVI	C,0	;clear the space from the bit map.
01:EBB6 CD6FEA          	  2608: 	CALL	SETFILE
01:EBB9 CDCAE9          	  2609: 	CALL	DIRWRITE;now write the directory sector back out.
01:EBBC CD31EB          	  2610: 	CALL	FINDNXT	;find the next file name.
01:EBBF C3A8EB          	  2611: 	JMP	ERAFIL1	;and repeat process.
                        	  2612: ;
                        	  2613: ;   Look through the space allocation map (bit map) for the
                        	  2614: ; next available block. Start searching at block number (BC-1).
                        	  2615: ; The search procedure is to look for an empty block that is
                        	  2616: ; before the starting block. If not empty, look at a later
                        	  2617: ; block number. In this way, we return the closest empty block
                        	  2618: ; on either side of the 'target' block number. This will speed
                        	  2619: ; access on random devices. For serial devices, this should be
                        	  2620: ; changed to look in the forward direction first and then start
                        	  2621: ; at the front and search some more.
                        	  2622: ;
                        	  2623: ;   On return, (DE)= block number that is empty and (HL) =0
                        	  2624: ; if no empry block was found.
                        	  2625: ;
01:EBC2 50              	  2626: FNDSPACE:MOV	D,B	;set (DE) as the block that is checked.
01:EBC3 59              	  2627: 	MOV	E,C
                        	  2628: ;
                        	  2629: ;   Look before target block. Registers (BC) are used as the lower
                        	  2630: ; pointer and (DE) as the upper pointer.
                        	  2631: ;
01:EBC4 79              	  2632: FNDSPA1	MOV	A,C	;is block 0 specified?
01:EBC5 B0              	  2633: 	ORA	B
01:EBC6 CAD5EB          	  2634: 	JZ	FNDSPA2
01:EBC9 0B              	  2635: 	DCX	B	;nope, check previous block.
01:EBCA D5              	  2636: 	PUSH	D
01:EBCB C5              	  2637: 	PUSH	B
01:EBCC CD39EA          	  2638: 	CALL	CKBITMAP
01:EBCF 1F              	  2639: 	RAR		;is this block empty?
01:EBD0 D2F0EB          	  2640: 	JNC	FNDSPA3	;yes. use this.
                        	  2641: ;
                        	  2642: ;   Note that the above logic gets the first block that it finds
                        	  2643: ; that is empty. Thus a file could be written 'backward' making
                        	  2644: ; it very slow to access. This could be changed to look for the
                        	  2645: ; first empty block and then continue until the start of this
                        	  2646: ; empty space is located and then used that starting block.
                        	  2647: ; This should help speed up access to some files especially on
                        	  2648: ; a well used disk with lots of fairly small 'holes'.
                        	  2649: ;
01:EBD3 C1              	  2650: 	POP	B	;nope, check some more.
01:EBD4 D1              	  2651: 	POP	D
                        	  2652: ;
                        	  2653: ;   Now look after target block.
                        	  2654: ;
01:EBD5 2ACAF1          	  2655: FNDSPA2	LHLD	DSKSIZE	;is block (DE) within disk limits?
01:EBD8 7B              	  2656: 	MOV	A,E
01:EBD9 95              	  2657: 	SUB	L
01:EBDA 7A              	  2658: 	MOV	A,D
01:EBDB 9C              	  2659: 	SBB	H
01:EBDC D2F8EB          	  2660: 	JNC	FNDSPA4
01:EBDF 13              	  2661: 	INX	D	;yes, move on to next one.
01:EBE0 C5              	  2662: 	PUSH	B
01:EBE1 D5              	  2663: 	PUSH	D
01:EBE2 42              	  2664: 	MOV	B,D
01:EBE3 4B              	  2665: 	MOV	C,E
01:EBE4 CD39EA          	  2666: 	CALL	CKBITMAP;check it.
01:EBE7 1F              	  2667: 	RAR		;empty?
01:EBE8 D2F0EB          	  2668: 	JNC	FNDSPA3
01:EBEB D1              	  2669: 	POP	D	;nope, continue searching.
01:EBEC C1              	  2670: 	POP	B
01:EBED C3C4EB          	  2671: 	JMP	FNDSPA1
                        	  2672: ;
                        	  2673: ;   Empty block found. Set it as used and return with (HL)
                        	  2674: ; pointing to it (true?).
                        	  2675: ;
01:EBF0 17              	  2676: FNDSPA3	RAL		;reset byte.
01:EBF1 3C              	  2677: 	INR	A	;and set bit 0.
01:EBF2 CD68EA          	  2678: 	CALL	STBMAP1	;update bit map.
01:EBF5 E1              	  2679: 	POP	H	;set return registers.
01:EBF6 D1              	  2680: 	POP	D
01:EBF7 C9              	  2681: 	RET
                        	  2682: ;
                        	  2683: ;   Free block was not found. If (BC) is not zero, then we have
                        	  2684: ; not checked all of the disk space.
                        	  2685: ;
01:EBF8 79              	  2686: FNDSPA4	MOV	A,C
01:EBF9 B0              	  2687: 	ORA	B
01:EBFA C2C4EB          	  2688: 	JNZ	FNDSPA1
01:EBFD 210000          	  2689: 	LXI	H,0	;set 'not found' status.
01:EC00 C9              	  2690: 	RET
                        	  2691: ;
                        	  2692: ;   Move a complete fcb entry into the directory and write it.
                        	  2693: ;
01:EC01 0E00            	  2694: FCBSET	MVI	C,0
01:EC03 1E20            	  2695: 	MVI	E,32	;length of each entry.
                        	  2696: ;
                        	  2697: ;   Move (E) bytes from the fcb pointed to by (PARAMS) into
                        	  2698: ; fcb in directory starting at relative byte (C). This updated
                        	  2699: ; directory buffer is then written to the disk.
                        	  2700: ;
01:EC05 D5              	  2701: UPDATE	PUSH	D
01:EC06 0600            	  2702: 	MVI	B,0	;set (BC) to relative byte position.
01:EC08 2A47E7          	  2703: 	LHLD	PARAMS	;get address of fcb.
01:EC0B 09              	  2704: 	DAD	B	;compute starting byte.
01:EC0C EB              	  2705: 	XCHG
01:EC0D CD62E9          	  2706: 	CALL	FCB2HL	;get address of fcb to update in directory.
01:EC10 C1              	  2707: 	POP	B	;set (C) to number of bytes to change.
01:EC11 CD53E7          	  2708: 	CALL	DE2HL
01:EC14 CDC7E7          	  2709: UPDATE1	CALL	TRKSEC	;determine the track and sector affected.
01:EC17 C3CAE9          	  2710: 	JMP	DIRWRITE	;then write this sector out.
                        	  2711: ;
                        	  2712: ;   Routine to change the name of all files on the disk with a
                        	  2713: ; specified name. The fcb contains the current name as the
                        	  2714: ; first 12 characters and the new name 16 bytes into the fcb.
                        	  2715: ;
01:EC1A CD58E9          	  2716: CHGNAMES:CALL	CHKWPRT	;check for a write protected disk.
01:EC1D 0E0C            	  2717: 	MVI	C,12	;match first 12 bytes of fcb only.
01:EC1F CD1CEB          	  2718: 	CALL	FINDFST	;get first name.
01:EC22 2A47E7          	  2719: 	LHLD	PARAMS	;get address of fcb.
01:EC25 7E              	  2720: 	MOV	A,M	;get user number.
01:EC26 111000          	  2721: 	LXI	D,16	;move over to desired name.
01:EC29 19              	  2722: 	DAD	D
01:EC2A 77              	  2723: 	MOV	M,A	;keep same user number.
01:EC2B CDF9E9          	  2724: CHGNAM1	CALL	CKFILPOS;any matching file found?
01:EC2E C8              	  2725: 	RZ		;no, we must be done.
01:EC2F CD48E9          	  2726: 	CALL	CHKROFL	;check for read only file.
01:EC32 0E10            	  2727: 	MVI	C,16	;start 16 bytes into fcb.
01:EC34 1E0C            	  2728: 	MVI	E,12	;and update the first 12 bytes of directory.
01:EC36 CD05EC          	  2729: 	CALL	UPDATE
01:EC39 CD31EB          	  2730: 	CALL	FINDNXT	;get te next file name.
01:EC3C C32BEC          	  2731: 	JMP	CHGNAM1	;and continue.
                        	  2732: ;
                        	  2733: ;   Update a files attributes. The procedure is to search for
                        	  2734: ; every file with the same name as shown in fcb (ignoring bit 7)
                        	  2735: ; and then to update it (which includes bit 7). No other changes
                        	  2736: ; are made.
                        	  2737: ;
01:EC3F 0E0C            	  2738: SAVEATTR:MVI	C,12	;match first 12 bytes.
01:EC41 CD1CEB          	  2739: 	CALL	FINDFST	;look for first filename.
01:EC44 CDF9E9          	  2740: SAVATR1	CALL	CKFILPOS;was one found?
01:EC47 C8              	  2741: 	RZ		;nope, we must be done.
01:EC48 0E00            	  2742: 	MVI	C,0	;yes, update the first 12 bytes now.
01:EC4A 1E0C            	  2743: 	MVI	E,12
01:EC4C CD05EC          	  2744: 	CALL	UPDATE	;update filename and write directory.
01:EC4F CD31EB          	  2745: 	CALL	FINDNXT	;and get the next file.
01:EC52 C344EC          	  2746: 	JMP	SAVATR1	;then continue until done.
                        	  2747: ;
                        	  2748: ;  Open a file (name specified in fcb).
                        	  2749: ;
01:EC55 0E0F            	  2750: OPENIT	MVI	C,15	;compare the first 15 bytes.
01:EC57 CD1CEB          	  2751: 	CALL	FINDFST	;get the first one in directory.
01:EC5A CDF9E9          	  2752: 	CALL	CKFILPOS;any at all?
01:EC5D C8              	  2753: 	RZ
01:EC5E CDAAE8          	  2754: OPENIT1	CALL	SETEXT	;point to extent byte within users fcb.
01:EC61 7E              	  2755: 	MOV	A,M	;and get it.
01:EC62 F5              	  2756: 	PUSH	PSW	;save it and address.
01:EC63 E5              	  2757: 	PUSH	H
01:EC64 CD62E9          	  2758: 	CALL	FCB2HL	;point to fcb in directory.
01:EC67 EB              	  2759: 	XCHG
01:EC68 2A47E7          	  2760: 	LHLD	PARAMS	;this is the users copy.
01:EC6B 0E20            	  2761: 	MVI	C,32	;move it into users space.
01:EC6D D5              	  2762: 	PUSH	D
01:EC6E CD53E7          	  2763: 	CALL	DE2HL
01:EC71 CD7CE9          	  2764: 	CALL	SETS2B7	;set bit 7 in 's2' byte (unmodified).
01:EC74 D1              	  2765: 	POP	D	;now get the extent byte from this fcb.
01:EC75 210C00          	  2766: 	LXI	H,12
01:EC78 19              	  2767: 	DAD	D
01:EC79 4E              	  2768: 	MOV	C,M	;into (C).
01:EC7A 210F00          	  2769: 	LXI	H,15	;now get the record count byte into (B).
01:EC7D 19              	  2770: 	DAD	D
01:EC7E 46              	  2771: 	MOV	B,M
01:EC7F E1              	  2772: 	POP	H	;keep the same extent as the user had originally.
