                        	  2333: ;
01:EA3F 79              	  2334: 	MOV	A,C
01:EA40 0F              	  2335: 	RRC		;now shift right 3 bits.
01:EA41 0F              	  2336: 	RRC
01:EA42 0F              	  2337: 	RRC
01:EA43 E61F            	  2338: 	ANI	1FH	;and clear bits 7,6,5.
01:EA45 4F              	  2339: 	MOV	C,A
01:EA46 78              	  2340: 	MOV	A,B
