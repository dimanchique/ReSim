01:EA48 87              	  2342: 	ADD	A
01:EA49 87              	  2343: 	ADD	A
01:EA4A 87              	  2344: 	ADD	A
01:EA4B 87              	  2345: 	ADD	A
01:EA4C B1              	  2346: 	ORA	C	;and add in (C).
01:EA4D 4F              	  2347: 	MOV	C,A	;ok, (C) ha been completed.
01:EA4E 78              	  2348: 	MOV	A,B	;is there a better way of doing this?
01:EA4F 0F              	  2349: 	RRC
01:EA50 0F              	  2350: 	RRC
01:EA51 0F              	  2351: 	RRC
01:EA52 E61F            	  2352: 	ANI	1FH
01:EA54 47              	  2353: 	MOV	B,A	;and now (B) is completed.
                        	  2354: ;
