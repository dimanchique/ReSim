01:E5B2 C335F3          	  1474: 	JMP	CONOUT
                        	  1475: ;
                        	  1476: ;   Signal a deleted line. Print a '#' at the end and start
                        	  1477: ; over.
                        	  1478: ;
01:E5B5 0E23            	  1479: NEWLINE	MVI	C,'#'
01:E5B7 CD4CE5          	  1480: 	CALL	OUTCHAR	;print this.
01:E5BA CDCDE5          	  1481: 	CALL	OUTCRLF	;start new line.
01:E5BD 3A10E7          	  1482: NEWLN1	LDA	CURPOS	;move the cursor to the starting position.
01:E5C0 210FE7          	  1483: 	LXI	H,STARTING
01:E5C3 BE              	  1484: 	CMP	M
01:E5C4 D0              	  1485: 	RNC		;there yet?
01:E5C5 0E20            	  1486: 	MVI	C,' '
01:E5C7 CD4CE5          	  1487: 	CALL	OUTCHAR	;nope, keep going.
01:E5CA C3BDE5          	  1488: 	JMP	NEWLN1
                        	  1489: ;
                        	  1490: ;   Output a (cr) (lf) to the console device (screen).
                        	  1491: ;
01:E5CD 0E0D            	  1492: OUTCRLF	MVI	C,CR
